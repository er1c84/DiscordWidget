<UserControl x:Class="DiscordFloatingWidget.Views.DiscordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DiscordFloatingWidget.Models"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="Toolbar" Background="{StaticResource PanelBrush}" Padding="5,4">
            <DockPanel LastChildFill="False">
                <Button Content="★" Click="Favorites_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Favorites" AutomationProperties.Name="Favorites" />
                <Button x:Name="BackButton" Content="←" Click="Back_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Back" AutomationProperties.Name="Back" IsEnabled="False" />
                <Button x:Name="ReloadButton" Content="↻" Click="Reload_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Reload Discord" AutomationProperties.Name="Reload Discord" />
                <Button Content="↗" Click="Browser_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Open in Browser" AutomationProperties.Name="Open in Browser" />
                <Button x:Name="MoreButton" Content="⋯" Click="More_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Browser options" AutomationProperties.Name="Browser options" DockPanel.Dock="Right">
                    <Button.ContextMenu>
                        <ContextMenu><MenuItem Header="Clear browser data…" Click="Clear_Click" /></ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>
        <Border x:Name="StatusPanel" Grid.Row="1" Padding="10,6" Visibility="Collapsed"
                Background="{StaticResource RaisedBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RuntimeButton" Content="Get WebView2 Runtime" Visibility="Collapsed" Click="Runtime_Click"
                        HorizontalAlignment="Left" Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Border>
        <Grid x:Name="PickerPanel" Grid.Row="2" Margin="12,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="AddButton" Content="+ Add" DockPanel.Dock="Right" Click="Add_Click"
                        Style="{StaticResource ActionButton}" AutomationProperties.Name="Add favorite" />
                <TextBlock Text="Your favorites" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyText" Text="Keep your regular chats close.&#x0a;&#x0a;Add a friend, group DM, or server channel using its Discord conversation link."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,16" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FavoritesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FavoriteConversation}">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Margin="0,0,0,7" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Tag="{Binding}" Click="OpenFavorite_Click" Style="{StaticResource FavoriteButton}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                            <StackPanel HorizontalAlignment="Left" Margin="6,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Content="✎" Tag="{Binding}" Click="Edit_Click" Style="{StaticResource HeaderButton}"
                                                ToolTip="Edit favorite" AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}" />
                                        <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="Remove_Click" Style="{StaticResource HeaderButton}"
                                                ToolTip="Remove favorite" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Button Grid.Row="2" Content="Open Discord" Click="OpenDiscord_Click" Style="{StaticResource ActionButton}"
                    Background="{StaticResource AccentBrush}" Margin="0,10,0,0" />
        </Grid>
        <!-- Separate layout rows avoid overlaying WPF controls on WebView2's HWND. -->
        <ContentControl x:Name="BrowserHost" Grid.Row="2" Visibility="Collapsed" />
        <StackPanel x:Name="CompactPanel" Grid.RowSpan="3" VerticalAlignment="Center" Margin="4" Visibility="Collapsed">
            <TextBlock x:Name="CompactLabel" Text="Your favorites" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="11" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                <Button Content="Favorites" Click="ExpandFavorites_Click" Style="{StaticResource ActionButton}" FontSize="10" MinHeight="24" />
                <Button Content="Expand" Click="Expand_Click" Style="{StaticResource ActionButton}" FontSize="10" MinHeight="24"
                        AutomationProperties.Name="Expand widget" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
