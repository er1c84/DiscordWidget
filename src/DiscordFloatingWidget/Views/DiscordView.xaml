<UserControl x:Class="DiscordFloatingWidget.Views.DiscordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:DiscordFloatingWidget.Models"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="Toolbar" Background="{StaticResource BackgroundBrush}" Padding="6,3" BorderBrush="{StaticResource RaisedBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="MoreButton" Content="⋯" Click="More_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Options" AutomationProperties.Name="Options" DockPanel.Dock="Right"
                        Width="26" Height="26" FontSize="16" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource WidgetOptionsMenu}">
                            <MenuItem x:Name="FocusMenu" Header="Chat-only view (experimental)" IsCheckable="True" IsChecked="True" Click="Focus_Click" />
                            <MenuItem Header="Manage favorites" Click="Favorites_Click" />
                            <MenuItem Header="Compact size" Click="CompactSize_Click" />
                            <Separator />
                            <MenuItem Header="Open Discord" Click="OpenDiscord_Click" />
                            <MenuItem x:Name="ReloadButton" Header="Reload" Click="Reload_Click" />
                            <MenuItem x:Name="BackButton" Header="Back" Click="Back_Click" />
                            <MenuItem Header="Open in Browser" Click="Browser_Click" />
                            <Separator />
                            <MenuItem Header="Clear browser data…" Click="Clear_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="QuickAddButton" Content="+" Click="Add_Click" Style="{StaticResource HeaderButton}"
                        ToolTip="Add friend or group" AutomationProperties.Name="Add friend or group" DockPanel.Dock="Right"
                        Width="26" Height="26" FontSize="16" VerticalAlignment="Center" Margin="2,0,0,0" />
                <TabControl x:Name="NavigationTabs" Style="{StaticResource WidgetTabs}" Height="28" SelectedIndex="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False"
                            SelectionChanged="NavigationTabs_SelectionChanged" AutomationProperties.Name="Widget views">
                    <TabItem x:Name="DiscordTab" Header="Discord" Style="{StaticResource WidgetTab}"
                             ToolTip="Return to the current Discord conversation" AutomationProperties.Name="Discord" />
                    <TabItem x:Name="FavoritesTab" Header="Favorites" Style="{StaticResource WidgetTab}"
                             ToolTip="Show saved conversations" AutomationProperties.Name="Favorites" />
                </TabControl>
            </DockPanel>
        </Border>
        <Border x:Name="StatusPanel" Grid.Row="1" Padding="10,6" Visibility="Collapsed"
                Background="{StaticResource RaisedBrush}">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RuntimeButton" Content="Get WebView2 Runtime" Visibility="Collapsed" Click="Runtime_Click"
                        HorizontalAlignment="Left" Style="{StaticResource ActionButton}" />
            </StackPanel>
        </Border>
        <Grid x:Name="PickerPanel" Grid.Row="2" Margin="12,10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="AddButton" Content="+ Add" DockPanel.Dock="Right" Click="Add_Click"
                        Style="{StaticResource ActionButton}" AutomationProperties.Name="Add favorite" />
                <TextBlock Text="Your favorites" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyText" Text="Keep your regular chats close.&#x0a;&#x0a;Add a friend or group DM using its Discord conversation link."
                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="6,16" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FavoritesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FavoriteConversation}">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Margin="0,0,0,7" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Button Tag="{Binding}" Click="OpenFavorite_Click" Style="{StaticResource FavoriteButton}"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                            <StackPanel HorizontalAlignment="Left" Margin="6,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Content="✎" Tag="{Binding}" Click="Edit_Click" Style="{StaticResource HeaderButton}"
                                                ToolTip="Edit favorite" AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}" />
                                        <Button Grid.Column="2" Content="×" Tag="{Binding}" Click="Remove_Click" Style="{StaticResource HeaderButton}"
                                                ToolTip="Remove favorite" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Button Grid.Row="2" Content="Open Discord" Click="OpenDiscord_Click" Style="{StaticResource ActionButton}"
                    Background="{StaticResource AccentBrush}" Margin="0,10,0,0" />
        </Grid>
        <!-- Separate layout rows avoid overlaying WPF controls on WebView2's HWND. -->
        <ContentControl x:Name="BrowserHost" Grid.Row="2" Visibility="Collapsed" />
    </Grid>
</UserControl>
